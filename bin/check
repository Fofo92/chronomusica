#!/usr/bin/env bash

set -euo pipefail

GREEN='\033[0;32m'
BLUE='\033[1;34m'
YELLOW='\033[1;33m'
RESET='\033[0m'

success() {
  echo -e "${GREEN}✔${RESET} $1"
}

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Chronomusica project checks"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo

echo -e "${BLUE}▶${RESET} Git status"
if ! git diff --quiet || ! git diff --cached --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  git status --short
else
  success "Working tree clean"
fi

echo
success "RSpec"
bin/rspec

echo
success "RuboCop"
bin/rubocop

echo
success "Zeitwerk"
bin/rails zeitwerk:check

echo
success "Ready for the next increment."
echo "🐷 Grouik !"
