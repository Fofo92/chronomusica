#!/usr/bin/env bash

set -uo pipefail

GREEN='\033[0;32m'
BLUE='\033[1;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
RESET='\033[0m'

overall_status="success"

info() {
  printf "%b▶%b %s\n" "$BLUE" "$RESET" "$1"
}

success() {
  printf "%b✔%b %s\n" "$GREEN" "$RESET" "$1"
}

warning() {
  printf "%b!%b %s\n" "$YELLOW" "$RESET" "$1"

  if [ "$overall_status" = "success" ]; then
    overall_status="warning"
  fi
}

error() {
  printf "%b✘%b %s\n" "$RED" "$RESET" "$1"
  overall_status="error"
}

run_check() {
  local label="$1"
  shift

  echo
  info "$label"

  if "$@"; then
    success "$label passed"
  else
    error "$label failed"
  fi
}

echo "══════════════════════════════════════"
echo "Chronomusica :: Project checks"
echo "══════════════════════════════════════"

echo
info "Git status"

if ! git diff --quiet ||
   ! git diff --cached --quiet ||
   [ -n "$(git ls-files --others --exclude-standard)" ]; then
  warning "Working tree is not clean"
  git status --short
else
  success "Working tree clean"
fi

run_check "RSpec" bin/rspec
run_check "RuboCop" bin/rubocop
run_check "Zeitwerk" bin/rails zeitwerk:check

echo
echo "══════════════════════════════════════"

case "$overall_status" in
  success)
    printf "🐷 %b✔%b Ready for the next increment.\n" \
      "$GREEN" "$RESET"
    ;;
  warning)
    printf "🐷 %b!%b Review the warnings before the next increment.\n" \
      "$YELLOW" "$RESET"
    ;;
  error)
    printf "🐷 %b✘%b Fix the errors before the next increment.\n" \
      "$RED" "$RESET"
    ;;
esac

echo "══════════════════════════════════════"

if [ "$overall_status" = "error" ]; then
  exit 1
fi
