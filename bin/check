#!/usr/bin/env bash

set -uo pipefail

GREEN='\033[0;32m'
BLUE='\033[1;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
RESET='\033[0m'

git_status="clean"
technical_status="success"

info() {
  printf "%b▶%b %s\n" "$BLUE" "$RESET" "$1"
}

success() {
  printf "%b✔%b %s\n" "$GREEN" "$RESET" "$1"
}

warning() {
  printf "%b!%b %s\n" "$YELLOW" "$RESET" "$1"
}

error() {
  printf "%b✘%b %s\n" "$RED" "$RESET" "$1"
  technical_status="error"
}

run_check() {
  local label="$1"
  shift

  echo
  info "$label"

  if "$@"; then
    success "$label passed"
  else
    error "$label failed"
  fi
}

echo "══════════════════════════════════════"
echo "Chronomusica : Project checks"
echo "══════════════════════════════════════"

echo
info "Git status"

if ! git diff --quiet ||
   ! git diff --cached --quiet ||
   [ -n "$(git ls-files --others --exclude-standard)" ]; then
  git_status="dirty"
  warning "Working tree is not clean"
  git status --short
else
  success "Working tree clean"
fi

run_check "RSpec" bin/rspec
run_check "RuboCop" bin/rubocop
run_check "Zeitwerk" bin/rails zeitwerk:check

echo
echo "══════════════════════════════════════"

if [ "$technical_status" = "error" ]; then

  printf "🐷 %b✘%b Fix the errors before the next increment.\n" \
    "$RED" "$RESET"
  exit_code=1

elif [ "$git_status" = "dirty" ]; then

  printf "🐷 %b!%b Ready for the next increment —\n" \
    "$YELLOW" "$RESET"
  echo "     just commit and push your work."

  exit_code=0

else

  printf "🐷 %b✔%b Ready for the next increment.\n" \
    "$GREEN" "$RESET"

  exit_code=0

fi

echo "══════════════════════════════════════"

exit "$exit_code"

echo "══════════════════════════════════════"

if [ "$overall_status" = "error" ]; then
  exit 1
fi
