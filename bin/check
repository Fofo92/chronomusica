#!/usr/bin/env bash

set -euo pipefail

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "🎼 Chronomusica project checks"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo

echo "🎼 Git status"
if ! git diff --quiet || ! git diff --cached --quiet || [ -n "$(git ls-files --others --exclude-standard)" ]; then
  git status --short
else
  echo "Working tree clean"
fi

echo
echo "🎼 RSpec"
bin/rspec

echo
echo "🎼 RuboCop"
bin/rubocop

echo
echo "🎼 Zeitwerk"
bin/rails zeitwerk:check

echo
echo "🎵 Ready for the next increment."
